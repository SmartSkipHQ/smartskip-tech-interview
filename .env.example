# Copy this file to .env and fill in what you need.
# The app boots and runs without any of these values.

# Port the API listens on. The web app proxies /api to this port.
PORT=3001

# Which implementation the AI layer should use: "mock" or "anthropic".
# "mock" needs no credentials and is what the repo ships with.
AI_PROVIDER=mock

# Only needed when AI_PROVIDER=anthropic. We hand you a temporary key
# at the start of the session, so you never have to use your own.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
