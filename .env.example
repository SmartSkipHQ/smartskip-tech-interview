# Copy this file to .env and fill in what you need.
# The app boots and runs without any of these values.

# Port the API listens on. The web app proxies /api to this port.
PORT=3001

# Where the weather comes from: "live" (Open-Meteo, the default) or "fixture".
# Fixture serves one fixed day, which is useful when you want the same numbers
# twice in a row.
WEATHER_MODE=live

# Which implementation decides the verdict: "mock" or "anthropic".
# "mock" is the rule-based one, needs no credentials, and is what the repo
# ships with. Switch to "anthropic" once you have written that advisor.
AI_PROVIDER=mock

# Only needed when AI_PROVIDER=anthropic. We hand you a temporary key
# at the start of the session, so you never have to use your own.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
